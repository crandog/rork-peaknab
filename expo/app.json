{
  "expo": {
    "name": "PeakNab",
    "slug": "peaknab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.peaknab",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PeakNab uses your photo library so you can attach a photo to your summit records.",
        "NSPhotoLibraryAddUsageDescription": "PeakNab saves summit share cards to your photo library so you can post them to Instagram Stories.",
        "LSApplicationQueriesSchemes": [
          "instagram-stories",
          "instagram"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.peaknab"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "PeakNab saves summit share cards to your photo library so you can post them to Instagram Stories.",
          "photosAddPermission": true,
          "isTransitive": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
